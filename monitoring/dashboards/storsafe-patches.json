{
  "title": "StorSafe Patch Management",
  "uid": "storsafe-patches",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "tags": [
    "storsafe"
  ],
  "description": "Versions, builds, patches and platform details across the estate.",
  "links": [
    {
      "title": "StorSafe dashboards",
      "type": "dashboards",
      "tags": [
        "storsafe"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {
          "text": "StorSafe Prometheus",
          "value": "storsafe-prometheus"
        }
      },
      {
        "name": "server",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(storsafe_up, server)",
          "refId": "A"
        },
        "definition": "label_values(storsafe_up, server)",
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "label": "Server"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Versions",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Appliances per version",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count by (version) (storsafe_info{server=~\"$server\"})",
          "legendFormat": "{{version}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "Appliances per build",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count by (build) (storsafe_info{server=~\"$server\"})",
          "legendFormat": "{{build}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "Appliances per OS",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count by (osversion) (storsafe_server_info{server=~\"$server\"})",
          "legendFormat": "{{osversion}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "wideLayout": true
      }
    },
    {
      "type": "table",
      "title": "Appliances",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (server, hostname, osversion, kernel, make, model, virtual) (storsafe_server_info{server=~\"$server\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "max by (server, product, version, build, apiversion) (storsafe_info{server=~\"$server\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "max by (server) (storsafe_patches_installed{server=~\"$server\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D",
          "expr": "max by (server) (storsafe_server_memory_bytes{server=~\"$server\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "E",
          "expr": "max by (server) (storsafe_server_cpus{server=~\"$server\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "F",
          "expr": "max by (server) (storsafe_time_offset_seconds{server=~\"$server\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "G",
          "expr": "max by (server) (storsafe_ntp_servers{server=~\"$server\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "H",
          "expr": "max by (server) (storsafe_server_option_enabled{server=~\"$server\",option=\"failover\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "I",
          "expr": "max by (server) (storsafe_encryption_option{server=~\"$server\",option=\"encryptionactive\"})",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Clock offset"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "server"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open instance",
                    "url": "/d/storsafe-instance/storsafe-instance?var-server=${__data.fields.server}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "instance": true,
              "job": true,
              "Time": true,
              "Value #A": true,
              "Value #B": true
            },
            "renameByName": {
              "Value #C": "Patches",
              "Value #D": "Memory",
              "Value #E": "CPUs",
              "Value #F": "Clock offset",
              "Value #G": "NTP servers",
              "Value #H": "Failover",
              "Value #I": "Encryption active"
            },
            "indexByName": {
              "server": 0,
              "hostname": 1,
              "product": 2,
              "version": 3,
              "build": 4,
              "Patches": 5,
              "osversion": 6,
              "kernel": 7,
              "make": 8,
              "model": 9,
              "virtual": 10,
              "Memory": 11,
              "CPUs": 12,
              "Clock offset": 13,
              "NTP servers": 14,
              "Failover": 15,
              "Encryption active": 16,
              "apiversion": 17
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "build",
                "desc": false
              }
            ]
          }
        }
      ],
      "description": "Build is the server build number; a dash and number after it is the patch level. Uptime is not exposed by the StorSafe REST API (the console's Service Uptime is a web GUI value); it can be added from SNMP sysUpTime if SNMP is enabled on the appliances."
    },
    {
      "type": "row",
      "title": "Patches",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Installed patches",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 12,
        "w": 16,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "storsafe_patch_info{server=~\"$server\"}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "instance": true,
              "job": true,
              "Time": true,
              "Value": true
            },
            "renameByName": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "server",
                "desc": false
              }
            ]
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Patch coverage",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 16,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count by (patch) (storsafe_patch_info{server=~\"$server\"})",
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "count(storsafe_up{server=~\"$server\"})",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "__name__": true,
              "instance": true,
              "job": true,
              "Time": true,
              "Value #B": true
            },
            "renameByName": {
              "Value #A": "Appliances with patch"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Appliances with patch",
                "desc": false
              }
            ]
          }
        }
      ],
      "description": "How many appliances have each patch. Compare with the appliance count in the Versions row to spot gaps."
    }
  ]
}