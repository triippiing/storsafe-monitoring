[Unit]
Description=StorSafe monitoring: collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__ROOT__
ExecStart=__PWSH__ -NoProfile -NonInteractive -File __ROOT__/Export-StorSafeMetrics.ps1 -All -NonInteractive
RuntimeMaxSec=__RUNTIME__
TimeoutStartSec=__RUNTIME__
SuccessExitStatus=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
