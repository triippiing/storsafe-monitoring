[Unit]
Description=StorSafe monitoring: Grafana
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__/grafana
ExecStart=__ROOT__/grafana/bin/grafana server --homepath __ROOT__/grafana
Environment=GF_PATHS_DATA=__ROOT__/grafana/data
Environment=GF_PATHS_LOGS=__ROOT__/grafana/data/log
Environment=GF_SERVER_HTTP_PORT=3000
Environment=GF_PATHS_PROVISIONING=__ROOT__/grafana/conf/provisioning
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
